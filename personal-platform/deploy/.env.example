# Personal Platform Environment Configuration
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# TWENTY CRM
# ═══════════════════════════════════════════════════════════
TWENTY_CRM_URL=http://localhost:3000
TWENTY_CRM_API_TOKEN=your-twenty-api-token-here

# ═══════════════════════════════════════════════════════════
# HERMES CRM / AGENT DASHBOARD
# ═══════════════════════════════════════════════════════════
HERMES_URL=http://localhost:4000
HERMES_API_KEY=your-hermes-api-key-here

# ═══════════════════════════════════════════════════════════
# PAPERCLIP AI AGENTS
# ═══════════════════════════════════════════════════════════
PAPERCLIP_URL=http://localhost:5000
PAPERCLIP_API_KEY=your-paperclip-api-key-here
PAPERCLIP_ORG_ID=your-org-id

# ═══════════════════════════════════════════════════════════
# WORLDMONITOR / BRANSON OS
# ═══════════════════════════════════════════════════════════
WORLD_MONITOR_URL=http://localhost:6000
WORLD_MONITOR_API_KEY=your-world-monitor-api-key-here

# ═══════════════════════════════════════════════════════════
# LLM PROVIDER (for AI agents)
# ═══════════════════════════════════════════════════════════
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
# Or use local Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# ═══════════════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════════════
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
OWNER_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# ═══════════════════════════════════════════════════════════
# OPENFOUNDRY PLATFORM
# ═══════════════════════════════════════════════════════════
OF_DOMAIN=localhost
OF_OIDC_ISSUER=https://accounts.google.com
OF_OIDC_CLIENT_ID=your-google-client-id
OF_OIDC_CLIENT_SECRET=your-google-client-secret
